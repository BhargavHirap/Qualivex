# Configure only in Vercel encrypted environment variables or local .env.local.
# Never commit real secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional conversational LLM provider (Groq free tier, subject to provider limits).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Legacy lead-scoring endpoint provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Business-configured Cal.com booking link is saved per workspace in qualification_profiles.
# Meta channel activation requires approved Meta app, verified webhook and business tokens.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_WHATSAPP_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
